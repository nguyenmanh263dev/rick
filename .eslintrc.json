{
  "root": true,
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    },
    "project": "./tsconfig.json"
  },
  "plugins": ["@typescript-eslint", "react", "react-hooks"],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-use-before-define": "off",
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/ban-types": [
      "error",
      {
        "types": {
          "any": {
            "message": "Avoid using the `any` type. Use proper typing instead.",
            "fixWith": "unknown"
          },
          "unknown": {
            "message": "Avoid using the `unknown` type. Use proper typing instead."
          },
          "never": {
            "message": "Avoid using the `never` type. Use proper typing instead."
          }
        }
      }
    ]
  }
}
